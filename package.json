{
  "name": "dug",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "DEV_API_ORIGIN=http://127.0.0.1:8787 concurrently -k -n api,web -c magenta,cyan \"pnpm dev:api\" \"next dev\"",
    "dev:api": "go run ./cmd/devapi",
    "dev:web": "DEV_API_ORIGIN=http://127.0.0.1:8787 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:api": "go test -short ./pkg/... ./api/... ./cmd/...",
    "test:live": "go test ./pkg/... -run 'Live|Spread|Traceroute|Expired' -v",
    "test:web": "node --test 'app/**/*.test.ts' 'lib/**/*.test.ts'",
    "vet": "go vet ./... && test -z \"$(gofmt -l api pkg cmd)\"",
    "verify": "pnpm typecheck && pnpm lint && pnpm vet && pnpm test:api && pnpm test:web && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@mcp-b/global": "5.0.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.86",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.19.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
